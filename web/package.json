{
  "name": "stupid-devtools-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src build.ts",
    "format": "oxfmt src build.ts",
    "check": "bun run typecheck && bun run lint && oxfmt --check src build.ts && bun test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
